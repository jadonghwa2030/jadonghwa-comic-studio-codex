# Local development only.
# Main generation uses Codex/ChatGPT OAuth, not API keys.
# First login once:
# npx @openai/codex login

# Optional: Codex OAuth proxy settings.
CODEX_OAUTH_PROXY_PORT=10531
CODEX_IMAGE_MODEL=gpt-5.4-mini
CODEX_TEXT_MODEL=gpt-5.5
CODEX_IMAGE_MODERATION=low

# Optional: local backend settings.
LOCAL_API_PORT=8787

# Optional: planner/research tuning (non-secret; safe to be client-visible).
VITE_CODEX_PLANNER_MODEL=gpt-5.5
VITE_CODEX_RESEARCH_MODEL=gpt-5.5
VITE_CODEX_RESEARCH_MAX_OUTPUT_TOKENS=8000

# Optional: Codex planning output length (04 Narrative Plan).
# Default: 30000
VITE_CODEX_MAX_OUTPUT_TOKENS=30000
VITE_CODEX_PLANNER_MAX_OUTPUT_TOKENS=30000

# Optional: Codex planning page-chunk size (helps with >10 pages).
# Default: 10
VITE_CODEX_MAX_PAGES_PER_REQUEST=10

# Optional: Page count cap (default: 12).
# - Frontend (Vite): affects Page Count input validation.
# - Backend (local API): affects research "recommended pages" clamping.
VITE_MAX_PAGE_COUNT=12
LOCAL_API_MAX_PAGE_COUNT=12
